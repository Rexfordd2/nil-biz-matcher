# Client-side Google Maps JavaScript API key (used in Discover Businesses feature)
# Create a Browser key with Maps JavaScript API + Places API enabled.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Region bias for server-side scripts/tools (not used by client loader)
# GOOGLE_MAPS_REGION_BIAS=us

# Server-side key (used by legacy server endpoint; not required for client feature)
# GOOGLE_MAPS_API_KEY=

# Supabase Configuration
# Client-side (exposed to browser via VITE_ prefix)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side (API endpoints only, NOT exposed to browser)
# These are preferred by API endpoints over VITE_* variants
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key (optional, bypasses RLS - use for server-side writes)
# Preferred over anon key for /api/waitlist and other server endpoints
SUPABASE_SERVICE_ROLE_KEY=

# Waitlist Embed (optional)
# URL for static waitlist form embed (Google Form, ConvertKit, Mailchimp, etc.)
# If not set, the waitlist section will show a fallback link
# VITE_WAITLIST_EMBED_URL=https://forms.google.com/your-form-id
# VITE_WAITLIST_EMBED_TITLE=Waitlist signup form

# Public Mode (optional)
# Enable public/no-login release mode where auth enforcement is bypassed
# Set VITE_PUBLIC_MODE=true (canonical) or NEXT_PUBLIC_PUBLIC_MODE=true (alias)
# When enabled:
#   - All auth enforcement is bypassed (no 401s for missing sessions)
#   - Auth providers (Supabase) remain intact but are optional
#   - User-specific features degrade gracefully
#   - Production builds succeed without Supabase/auth secrets
#   - App runs in anonymous mode; login/signup are optional
# VITE_PUBLIC_MODE=true
# NEXT_PUBLIC_PUBLIC_MODE=true

# Debug access (optional)
# Set VITE_DIAGNOSTICS=true to enable debug routes in production
# Or set VITE_DEBUG_KEY to a secret value and use ?debugKey=<secret> to access debug routes
# VITE_DIAGNOSTICS=
# VITE_DEBUG_KEY=

# Core app
# AUTH_SECRET is used to sign session cookies for API auth (when DB is used)
AUTH_SECRET=change-me-to-a-long-random-string

# Database (optional for MVP; the app works with localStorage only)
DATABASE_URL="file:./prisma/dev.db"

# App URL (required for recruiting email links)
# e.g., http://localhost:5173 for dev; https://athlete-ledger.example.com for prod
APP_URL=http://localhost:5173

# Business Search (optional; falls back to mock results if not set)
# Google Places Text Search API key
GOOGLE_MAPS_API_KEY=
# Optional: region bias (e.g., 'us')
GOOGLE_MAPS_REGION_BIAS=

# SMTP / Email (optional; if not set, API returns HTTP 503 on send attempts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address used for emails, e.g., "Athlete Ledger <no-reply@yourdomain.com>"
SMTP_FROM=

# Server-side Google Maps / Places API key (NOT exposed to client)
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_OR_PLACES_API_KEY"

# Optional: region bias for search (e.g., us, ca)
GOOGLE_MAPS_REGION_BIAS="us"

DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-this-to-a-long-random-string"

# SMTP (optional; required for recruiting email)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER="YOUR_SMTP_USER"
SMTP_PASS="YOUR_SMTP_PASS"
SMTP_FROM="Athlete Ledger <no-reply@athleteledger.app>"

# App base URL (required by email tracking/links)
APP_URL="http://localhost:5173"

# Client-side env (Vite exposes only VITE_*)
VITE_BUSINESS_SEARCH_PROVIDER="mock"
VITE_YELP_API_KEY="YOUR_YELP_API_KEY_OR_LEAVE_EMPTY"
VITE_YELP_PROXY_URL="YOUR_PROXY_URL_OR_LEAVE_EMPTY"
