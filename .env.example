# ==============================================================================
# App Instance Identification
# ==============================================================================
# Used to identify which Vercel project deployment this is
# Helps prevent accidentally deploying to the wrong project
# Examples: "athlete-ledger-production", "athlete-ledger-beta", "nil-bizmatcher"
VITE_APP_INSTANCE=athlete-ledger-production

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Required for authentication and database features
# Get these from: https://supabase.com/dashboard/project/[your-project]/settings/api
VITE_SUPABASE_URL=https://[your-project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# Athlete Houze Intelligence evidence (server-only)
# ==============================================================================
# Keep these unprefixed so Vite never exposes them to the browser bundle.
# Reporting remains limited to authenticated canary accounts unless the explicit
# operator gate below is enabled. HMAC is sufficient; no bearer token is needed.
ATHLETE_HOUZE_REPORT_URL=
ATHLETE_HOUZE_REPORT_HMAC_SECRET=
# off | canary | all. Missing/unknown values fail closed to off.
ATHLETE_HOUZE_REPORTING_MODE=off
# In canary mode this must exactly match the operator-controlled Supabase
# app_metadata.athlete_houze_external_id on the synthetic test account.
ATHLETE_HOUZE_REPORT_CANARY_EXTERNAL_ID=
# Required in addition to mode=all. Do not enable before consent approval.
ATHLETE_HOUZE_REPORT_ALL_ENABLED=false

# ==============================================================================
# Workflow cloud persistence (opportunities, deals, events) — account canary
# ==============================================================================
# Master kill switch. Default: false (absent also means disabled).
# Only the exact string "true" enables the master switch, and only when Supabase
# is configured. Master alone does NOT globally activate cloud persistence.
# Do not enable via query params or UI.
VITE_WORKFLOW_CLOUD_PERSISTENCE=false

# Rollout mode: off | canary | all
# Missing / empty / unknown → off.
#   off     — all users local-only (even if master is true)
#   canary  — cloud only when Auth app_metadata.workflow_cloud_persistence_canary === true
#   all     — cloud for every otherwise eligible authenticated user with a valid athlete ID
#
# Proposed Production canary (NOT ENABLED BY THIS COMMIT):
#   VITE_WORKFLOW_CLOUD_PERSISTENCE=true
#   VITE_WORKFLOW_CLOUD_PERSISTENCE_MODE=canary
#   VITE_EXISTING_USER_LOGIN_ENABLED=true
# Signup must remain disabled under public mode.
VITE_WORKFLOW_CLOUD_PERSISTENCE_MODE=off

# ==============================================================================
# Existing-user login (independent from public signup)
# ==============================================================================
# When VITE_PUBLIC_MODE=true, login and signup are disabled by default.
# Exact "true" re-enables password login for confirmed accounts only.
# Signup remains disabled under public mode. Default: false.
# NOT ENABLED BY THIS COMMIT in Production / Preview.
VITE_EXISTING_USER_LOGIN_ENABLED=false

# ==============================================================================
# Google Maps API Configuration
# ==============================================================================
# Required for Discover and Recruiting features (map-based business search)
# 
# Setup instructions:
# 1. Go to https://console.cloud.google.com
# 2. Create or select a project
# 3. Enable these APIs:
#    - Maps JavaScript API
#    - Places API
# 4. Create a Browser API key with HTTP referrer restrictions
# 5. Copy the API key below
#
# Local development:
#   Add this to .env or .env.local, then restart dev server
#
# Vercel deployment:
#   1. Go to Vercel Dashboard → Your Project → Settings → Environment Variables
#   2. Add VITE_GOOGLE_MAPS_API_KEY with your API key
#   3. Select environments: Production, Preview, Development
#   4. Save and redeploy
#
# Note: If not configured, Discover and Recruiting will show a disabled state
#       and will not crash the app.
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...

# Test Credentials (for diagnostic scripts)
# Create a test user in Supabase Auth for running diagnostics
SUPABASE_TEST_EMAIL=test@example.com
SUPABASE_TEST_PASSWORD=test-password-123

# Optional: Vercel deployment (only needed for CI/CD)
VERCEL_TOKEN=...
VERCEL_ORG_ID=...
VERCEL_PROJECT_ID=...
