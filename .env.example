# Server-side Google Maps / Places API key (NOT exposed to client)
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_OR_PLACES_API_KEY"

# Optional: region bias for search (e.g., us, ca)
GOOGLE_MAPS_REGION_BIAS="us"

DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-this-to-a-long-random-string"

# SMTP (optional; required for recruiting email)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER="YOUR_SMTP_USER"
SMTP_PASS="YOUR_SMTP_PASS"
SMTP_FROM="Athlete Ledger <no-reply@athleteledger.app>"

# App base URL (required by email tracking/links)
APP_URL="http://localhost:5173"

# Client-side env (Vite exposes only VITE_*)
VITE_BUSINESS_SEARCH_PROVIDER="mock"
VITE_YELP_API_KEY="YOUR_YELP_API_KEY_OR_LEAVE_EMPTY"
VITE_YELP_PROXY_URL="YOUR_PROXY_URL_OR_LEAVE_EMPTY"

