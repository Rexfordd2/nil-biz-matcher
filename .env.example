# Core business search configuration
# VITE_ prefix is required for Vite to expose variables to the client.

# Which provider to use for business search.
# Options: "mock" (local fake data), "yelp" (Yelp Fusion API or your proxy)
VITE_BUSINESS_SEARCH_PROVIDER=mock

# Yelp API key (server-to-API direct calls; only if you are NOT using a proxy).
# WARNING: Do not commit real secrets. In production, inject via your hosting env.
VITE_YELP_API_KEY=

# If you run a server-side proxy that attaches the Yelp API key,
# set its public search endpoint here. When set, the client will call this URL
# without sending the API key from the browser.
# Example: https://your-domain.com/api/yelp/search
VITE_YELP_PROXY_URL=


