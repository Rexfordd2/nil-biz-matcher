{
  "name": "athlete-ledger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "_comment_build": "build = standard build (requires debug protection); build:public = public release mode (no auth required)",
    "dev": "vite",
    "prebuild": "node scripts/prepare-build-env.mjs",
    "build": "tsc -b && node scripts/print-build-info.js && vite build",
    "build:public": "cross-env VITE_PUBLIC_MODE=true npm run build",
    "deploy:public": "npm run build:public && vercel --prod",
    "prevercel-build": "node scripts/check-no-submodules.mjs && node scripts/prepare-build-env.mjs",
    "vercel-build": "tsc -b && cross-env VITE_BUILD_ID=$VERCEL_GIT_COMMIT_SHA vite build && node scripts/copy-demo-html.mjs",
    "vercel-build:public": "cross-env VITE_PUBLIC_MODE=true npm run vercel-build",
    "preview": "vite preview --port 5173",
    "start": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run --exclude \"tests/**\"",
    "test:launch-status": "vitest run scripts/__tests__/launch-status.test.ts",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:smoke:ui": "playwright test --ui tests/smoke.spec.ts",
    "test:public-release": "playwright test tests/public-release.spec.ts",
    "test:public-release:ui": "playwright test --ui tests/public-release.spec.ts",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "smoke:vercel:prod": "node scripts/smoke-vercel-prod.mjs",
    "seed:recruiting": "node scripts/seedRecruiting.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate || true",
    "get:vercel:domains": "node scripts/get-vercel-domains.mjs",
    "verify:domains": "node scripts/verify-domains.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:all-domains": "node scripts/verify-all-domains.mjs",
    "verify:prod": "node scripts/verify-all-domains.mjs",
    "verify:lint": "tsc --noEmit",
    "verify:vercel": "node scripts/verify-vercel.mjs",
    "vercel:env": "node scripts/vercel-env-setup.mjs",
    "supabase:migrate": "node scripts/supabase-migrate.mjs",
    "diag:profile": "node scripts/diagnose-athlete-profile.mjs",
    "diag:profile:cli": "node scripts/diagnose-athlete-profile.mjs --email=$SUPABASE_TEST_EMAIL --password=$SUPABASE_TEST_PASSWORD",
    "diag:profile:prompt": "node scripts/diagnose-athlete-profile.mjs --prompt",
    "launch:status": "node scripts/launch-status.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@react-spring/web": "^9.7.5",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.87.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "nodemailer": "^6.9.15",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-tinder-card": "^1.6.4",
    "react-to-print": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/google.maps": "^3.58.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.19.3",
    "@types/nodemailer": "^6.4.15",
    "@types/papaparse": "^5.2.7",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^3.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "esbuild": "^0.27.2",
    "playwright": "^1.49.0",
    "postcss": "^8.4.49",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.4"
  }
}
