{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "routes": [
    {
      "src": "/healthz",
      "dest": "/api/healthz"
    },
    {
      "src": "/demo",
      "dest": "/demo.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!api(?:/|$)).*)",
      "dest": "/index.html"
    }
  ]
}